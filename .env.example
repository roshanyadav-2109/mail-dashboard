# ── Login ────────────────────────────────────────────────────────────────────
# Google OAuth client (Google Cloud Console).
# Authorised redirect URIs: <APP_URL>/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random string: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated Google emails allowed to log in
ALLOWED_EMAILS=you@gmail.com,other@gmail.com

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin of this app, no trailing slash (used in unsubscribe links).
APP_URL=https://your-app.vercel.app
# Secret for signing unsubscribe links (falls back to AUTH_SECRET). Changing it breaks old links.
UNSUB_SECRET=

# ── Supabase (dedicated project; run supabase/schema.sql first) ──────────────
SUPABASE_URL=
# Service-role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS SES (server only) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
# Sender - MUST be an @unknowniitians.in address (the app refuses anything else)
SES_FROM=Unknown IITians <mail@unknowniitians.in>
# Configuration set that publishes events to SNS (see README)
SES_CONFIGURATION_SET=
# Optional: only accept webhook messages from this SNS topic
SNS_TOPIC_ARN=
